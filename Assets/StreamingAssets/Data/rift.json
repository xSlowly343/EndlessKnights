  "modifiersPerWindow": 2,
  "markBonus": 0.5,
  "modifiers": [
    { "id": "stone_skin", "unlessMarks": ["curse", "time"], "favours": ["curse", "time"], "modifiers": [{ "stat": "damage", "kind": "more", "value": -0.5 }] },
    { "id": "regeneration", "unlessMarks": ["poison", "fire"], "favours": ["poison", "fire"], "modifiers": [{ "stat": "damage", "kind": "more", "value": -0.3 }] },
    { "id": "colossus_shield", "unlessMarks": ["lightning", "hunterMark"], "favours": ["lightning", "hunterMark"], "modifiers": [{ "stat": "damage", "kind": "more", "value": -0.3 }] },
    { "id": "horde", "favours": ["summon"], "modifiers": [{ "stat": "damage", "kind": "more", "value": -0.25 }, { "stat": "gold", "kind": "more", "value": 0.5 }] },
    { "id": "silence", "favours": ["stun"], "modifiers": [{ "stat": "auraEffect", "kind": "more", "value": -0.5, "tags": ["Aura"] }] },
    { "id": "eclipse", "favours": ["series"], "modifiers": [{ "stat": "damage", "kind": "more", "value": -0.5, "tags": ["Keyboard"] }, { "stat": "mouseDistance", "kind": "more", "value": 1 }] }
  ]

      {
        "id": "gardeners",
        "guild": "gardeners",
        "name": { "ru": "Дом травницы", "en": "Herbwitch's House" },
        "master": "herbwitch",
        "district": "gates",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 600, "wood": 25, "herbs": 6 } },
          { "afterBuilt": 4, "perPlayerDay": { "labour": 900, "stone": 20, "clay": 10, "herbs": 10, "potions": 1 } },
          { "afterBuilt": 12, "perPlayerDay": { "labour": 1200, "salt": 6, "skyglass": 2, "herbs": 14, "dishes": 1, "tinctures": 1 } }
        ],
        "lines": [
          { "ru": "Палатка — не дом. Травам нужна крыша и сухой чердак.", "en": "A tent is no house. Herbs need a roof and a dry loft." },
          { "ru": "Принесите дерева, а я научу ваш сад слушаться.", "en": "Bring wood, and I'll teach your garden to listen." },
          { "ru": "Изнанка пахнет железом. Мои травы — мятой. Строим?", "en": "The Rift smells of iron. My herbs smell of mint. Shall we build?" }
        ]
      },
      {
        "id": "alchemists",
        "guild": "alchemists",
        "name": { "ru": "Лавка алхимика", "en": "Alchemist's Shop" },
        "master": "alchemist",
        "district": "gates",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 700, "wood": 25, "herbs": 8, "finds": 2 } },
          { "afterBuilt": 4, "perPlayerDay": { "labour": 1000, "clay": 15, "ore": 6, "herbs": 10 } },
          { "afterBuilt": 12, "perPlayerDay": { "labour": 1300, "coal": 4, "skyglass": 3, "finds": 8, "relics": 1 } }
        ],
        "lines": [
          { "ru": "Котёл у меня есть. Стен вокруг него — пока нет.", "en": "I have a cauldron. Walls around it — not yet." },
          { "ru": "Каждая доска — это зелье, которое не взорвётся под дождём.", "en": "Every plank is a potion that won't blow up in the rain." },
          { "ru": "Глина для колб, стекло для окон — и Кромка запахнет наукой.", "en": "Clay for flasks, glass for windows — and the Edge will smell of science." }
        ]
      },
      {
        "id": "fishers",
        "guild": "fishers",
        "name": { "ru": "Пристань рыбаков", "en": "Fishers' Wharf" },
        "master": "ghostcaptain",
        "district": "ice_harbor",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 1200, "wood": 40, "herbs": 6, "finds": 4 } },
          { "afterBuilt": 5, "perPlayerDay": { "labour": 1500, "stone": 25, "clay": 8, "salt": 6, "potions": 1 } },
          { "afterBuilt": 14, "perPlayerDay": { "labour": 1800, "skyglass": 3, "amber": 2, "metalwork": 1, "dishes": 2 } }
        ],
        "lines": [
          { "ru": "Пристань строят из дерева и терпения. Терпения у меня на века.", "en": "A wharf is built of wood and patience. I have centuries of patience." },
          { "ru": "Лёд держит лодку лучше якоря. Но сваи всё равно нужны.", "en": "Ice holds a boat better than an anchor. We still need piles." },
          { "ru": "Соль на досках — к удаче. Сыпьте не жалея.", "en": "Salt on the boards brings luck. Don't spare it." }
        ]
      },
      {
        "id": "smiths",
        "guild": "smiths",
        "name": { "ru": "Кузня", "en": "Smithy" },
        "master": "golemancer",
        "district": "smith_row",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 1500, "wood": 30, "stone": 10, "finds": 8 } },
          { "afterBuilt": 5, "perPlayerDay": { "labour": 1800, "stone": 30, "ore": 20, "coal": 4 } },
          { "afterBuilt": 14, "perPlayerDay": { "labour": 2000, "coal": 10, "marble": 2, "starmetal": 2, "fish": 4 } }
        ],
        "lines": [
          { "ru": "Голем держит молот. Мне нужно, чтобы кто-то держал крышу.", "en": "The golem holds the hammer. I need someone to hold the roof." },
          { "ru": "Камень для горна, руда для наковальни. Остальное — дело рук.", "en": "Stone for the hearth, ore for the anvil. The rest is handiwork." },
          { "ru": "Звёздное железо поёт под молотом. Вы его ещё услышите.", "en": "Star iron sings under the hammer. You'll hear it yet." }
        ]
      },
      {
        "id": "cooks",
        "guild": "cooks",
        "name": { "ru": "Харчевня", "en": "Tavern Kitchen" },
        "master": "minstrel",
        "district": "sky_square",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 1300, "wood": 30, "herbs": 12, "finds": 4, "fish": 2 } },
          { "afterBuilt": 6, "perPlayerDay": { "labour": 1500, "clay": 15, "salt": 6, "fish": 6, "potions": 1 } },
          { "afterBuilt": 16, "perPlayerDay": { "labour": 1800, "marble": 2, "amber": 2, "metalwork": 2, "tinctures": 1 } }
        ],
        "lines": [
          { "ru": "Песня без ужина — полпесни. Построим кухню!", "en": "A song without supper is half a song. Let's build a kitchen!" },
          { "ru": "Мне нужен очаг, а очагу — стены. Подпевайте и несите брёвна.", "en": "I need a hearth, and the hearth needs walls. Sing along and carry logs." },
          { "ru": "Когда здесь запахнет похлёбкой, Стражи сами придут строить дальше.", "en": "Once it smells of stew here, the Wardens will come to build on their own." }
        ]
      },
      {
        "id": "diggers",
        "guild": "diggers",
        "name": { "ru": "Контора раскопщиков", "en": "Diggers' Lodge" },
        "master": "dowser",
        "district": "sand_bazaar",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 1600, "wood": 35, "herbs": 4, "finds": 10 } },
          { "afterBuilt": 6, "perPlayerDay": { "labour": 2000, "stone": 20, "clay": 10, "metalwork": 1 } },
          { "afterBuilt": 16, "perPlayerDay": { "labour": 2200, "ore": 10, "riftdust": 3, "dishes": 2 } }
        ],
        "lines": [
          { "ru": "Лоза дрожит — под Кромкой что-то есть. Сначала контора, потом лопаты.", "en": "The rod trembles — something lies under the Edge. Lodge first, shovels later." },
          { "ru": "Каждая находка ищет полку. Полкам нужны доски.", "en": "Every find wants a shelf. Shelves want planks." },
          { "ru": "Пыль Изнанки не копают руками. Для неё нужен свой подвал.", "en": "Rift dust isn't dug by hand. It needs a cellar of its own." }
        ]
      },
      {
        "id": "distillers",
        "guild": "distillers",
        "name": { "ru": "Перегонная", "en": "Distillery" },
        "master": "lanternbearer",
        "district": "sky_square",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 1300, "wood": 25, "clay": 10, "herbs": 10, "potions": 1 } },
          { "afterBuilt": 7, "perPlayerDay": { "labour": 1500, "ore": 8, "skyglass": 2, "dishes": 1 } },
          { "afterBuilt": 18, "perPlayerDay": { "labour": 1800, "amber": 3, "riftdust": 2, "relics": 2 } }
        ],
        "lines": [
          { "ru": "Фонарь светит ярче, когда в нём настойка. Стройте — я посвечу.", "en": "A lantern shines brighter with a tincture in it. Build — I'll hold the light." },
          { "ru": "Медные трубы, стеклянные колбы и немного тишины. Больше мне не надо.", "en": "Copper pipes, glass flasks and a little quiet. That's all I need." },
          { "ru": "Янтарь хранит свет тысячу лет. Пусть хранит и наш.", "en": "Amber keeps light for a thousand years. Let it keep ours too." }
        ]
      },
      {
        "id": "palisade",
        "name": { "ru": "Частокол", "en": "Palisade" },
        "master": "clockwright",
        "district": "gates",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 800, "wood": 30 } },
          { "afterBuilt": 6, "perPlayerDay": { "labour": 1200, "stone": 30, "ore": 5 } },
          { "afterBuilt": 20, "perPlayerDay": { "labour": 1500, "marble": 3, "starmetal": 1 } }
        ],
        "lines": [
          { "ru": "Ровно сорок кольев — и твари Изнанки станут обходить нас.", "en": "Exactly forty stakes — and the Rift's beasts will walk around us." },
          { "ru": "Камень вместо дерева, и я перестану считать трещины по ночам.", "en": "Stone instead of wood, and I'll stop counting cracks at night." },
          { "ru": "Хорошая стена тикает в такт с городом. Я проверял.", "en": "A good wall ticks in time with the town. I checked." }
        ]
      },
      {
        "id": "well",
        "name": { "ru": "Колодец", "en": "Well" },
        "master": "dreamcatcher",
        "district": "gates",
        "levels": [
          { "afterBuilt": 0, "perPlayerDay": { "labour": 500, "wood": 15, "finds": 2 } },
          { "afterBuilt": 5, "perPlayerDay": { "labour": 800, "stone": 15, "clay": 8 } }
        ],
        "lines": [
          { "ru": "Вода из глубины видит сны. Давайте её достанем.", "en": "Water from the deep dreams. Let's draw it up." },
          { "ru": "Над колодцем повешу ловец снов — пусть пьют спокойно.", "en": "I'll hang a dreamcatcher over the well — let them drink in peace." },
          { "ru": "Камень сохранит воду холодной даже в окно Разлома.", "en": "Stone will keep the water cold even in a Rift window." }
        ]
      },
      {
        "id": "warehouse",
        "name": { "ru": "Склад", "en": "Warehouse" },
        "master": "sandwalker",
        "district": "gates",
        "levels": [
          { "afterBuilt": 2, "perPlayerDay": { "labour": 900, "wood": 35, "finds": 4 } },
          { "afterBuilt": 7, "perPlayerDay": { "labour": 1200, "stone": 20, "ore": 6 } },
          { "afterBuilt": 20, "perPlayerDay": { "labour": 1500, "marble": 2, "amber": 2 } }
        ],
        "lines": [
          { "ru": "Песок сыплется везде, кроме хорошего склада.", "en": "Sand gets in everywhere except a good warehouse." },
          { "ru": "Город, которому негде хранить запасы, живёт одним днём.", "en": "A town with nowhere to keep its stock lives one day at a time." },
          { "ru": "Полки до потолка — и ни одной пустой. Вот мечта.", "en": "Shelves to the ceiling, not one empty. That's the dream." }
        ]
      },
      {
        "id": "market",
        "name": { "ru": "Рынок", "en": "Market" },
        "master": "cartomancer",
        "district": "green_market",
        "levels": [
          { "afterBuilt": 3, "perPlayerDay": { "labour": 1000, "wood": 25, "herbs": 6, "finds": 6 } },
          { "afterBuilt": 9, "perPlayerDay": { "labour": 1300, "stone": 15, "salt": 4, "dishes": 1 } },
          { "afterBuilt": 20, "perPlayerDay": { "labour": 1600, "skyglass": 2, "amber": 3, "tinctures": 1 } }
        ],
        "lines": [
          { "ru": "Карты говорят: будет торг. Значит, нужны прилавки.", "en": "The cards say there'll be trade. So we need stalls." },
          { "ru": "Каждый прилавок — новая масть в колоде города.", "en": "Every stall is a new suit in the town's deck." },
          { "ru": "Под стеклянной крышей и дождь торгуется честно.", "en": "Under a glass roof even the rain bargains fairly." }
        ]
      },
      {
        "id": "clock_tower",
        "name": { "ru": "Часовая башня", "en": "Clock Tower" },
        "master": "clockwright",
        "district": "sky_square",
        "levels": [
          { "afterBuilt": 8, "perPlayerDay": { "labour": 1400, "wood": 20, "stone": 25, "ore": 8 } },
          { "afterBuilt": 18, "perPlayerDay": { "labour": 1800, "skyglass": 3, "starmetal": 1, "metalwork": 2 } }
        ],
        "lines": [
          { "ru": "Городу нужно общее время. Иначе все опаздывают по-разному.", "en": "A town needs a shared time. Otherwise everyone is late differently." },
          { "ru": "Шестерни я выточу сам. От вас — камень и терпение.", "en": "I'll cut the gears myself. From you — stone and patience." },
          { "ru": "Когда башня пробьёт полдень, Кромка станет городом.", "en": "When the tower strikes noon, the Edge becomes a town." }
        ]
      },
      {
        "id": "lighthouse",
        "name": { "ru": "Маяк", "en": "Lighthouse" },
        "master": "mothcaller",
        "district": "ice_harbor",
        "levels": [
          { "afterBuilt": 10, "perPlayerDay": { "labour": 1300, "stone": 25, "salt": 6, "fish": 3 } },
          { "afterBuilt": 20, "perPlayerDay": { "labour": 1600, "skyglass": 4, "amber": 3 } }
        ],
        "lines": [
          { "ru": "Мотыльки летят на свет. Корабли — тоже. Построим им свет.", "en": "Moths fly to the light. So do ships. Let's build them a light." },
          { "ru": "Маяк над ледяной гаванью — и лодки вернутся даже в метель.", "en": "A lighthouse over the ice harbor — and boats come home even in a blizzard." },
          { "ru": "Янтарное стекло даст тёплый луч. Мотылькам понравится.", "en": "Amber glass makes a warm beam. The moths will love it." }
        ]
      },
      {
        "id": "sky_bridge",
        "name": { "ru": "Небесный мост", "en": "Sky Bridge" },
        "master": "windshot",
        "district": "sky_square",
        "levels": [
          { "afterBuilt": 12, "perPlayerDay": { "labour": 1600, "wood": 30, "stone": 30, "skyglass": 2 } },
          { "afterBuilt": 22, "perPlayerDay": { "labour": 1900, "marble": 3, "starmetal": 2 } }
        ],
        "lines": [
          { "ru": "Ветер сам подскажет, где ставить опоры. Я его слышу.", "en": "The wind will tell us where to set the piers. I can hear it." },
          { "ru": "Мост на Небесную площадь — и до облаков рукой подать.", "en": "A bridge to Sky Square — and the clouds are within reach." },
          { "ru": "Звёздное железо не боится высоты. Как и я.", "en": "Star iron isn't afraid of heights. Neither am I." }
        ]
      },
      {
        "id": "wardens_hall",
        "name": { "ru": "Зал Стражей", "en": "Wardens' Hall" },
        "master": "runedancer",
        "district": "rift_crack",
        "levels": [
          { "afterBuilt": 16, "perPlayerDay": { "labour": 2000, "marble": 3, "riftdust": 4, "metalwork": 2 } },
          { "afterBuilt": 25, "perPlayerDay": { "labour": 2400, "starmetal": 3, "riftdust": 5, "relics": 2 } }
        ],
        "lines": [
          { "ru": "У Трещины должен стоять зал, где помнят всех, кто держал Кромку.", "en": "By the Crack there must be a hall that remembers all who held the Edge." },
          { "ru": "Руны на мраморе живут дольше, чем на коже. Высечем имена.", "en": "Runes on marble outlive runes on skin. Let's carve the names." },

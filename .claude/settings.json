{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File build.ps1:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File Tools/*)",
      "PowerShell(git:*)",
      "PowerShell(gh:*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File build.ps1:*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File Tools/*)",
      "Read(/**)",
      "Edit(/**)",
      "WebFetch(domain:fonts.google.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(rm:*)"
    ]
  }
}
